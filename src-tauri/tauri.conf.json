{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SDigitalCore",
  "version": "0.1.4",
  "identifier": "com.sdigitalcore.desktop",
  "build": {
    "devUrl": "https://sdigitalcore.vercel.app",
    "frontendDist": "https://sdigitalcore.vercel.app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["sdigitalcore"],
          "appLink": false
        }
      ]
    }
  }
}
