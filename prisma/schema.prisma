}

enum StockCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("stock_count_status")
}

// ============================================================
// CONTEO DE STOCK & AUDITORÍA DE INVENTARIO
// ============================================================

model StockCount {
  id          String           @id @default(cuid())
  countNumber String           @unique @map("count_number")
  title       String           @default("Conteo Físico de Stock")
  branch      String
  performedBy String           @map("performed_by")
  status      StockCountStatus @default(IN_PROGRESS)
  notes       String?          @db.Text
  startedAt   DateTime         @default(now()) @map("started_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  items StockCountItem[]

  @@map("stock_count")
}

model StockCountItem {
  id           String     @id @default(cuid())
  countId      String     @map("count_id")
  count        StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  code         String?
  description  String
  expectedQty  Int        @default(0) @map("expected_qty")
  countedQty   Int        @default(0) @map("counted_qty")
  difference   Int        @default(0)
  scannedImeis String?    @map("scanned_imeis") @db.Text
  notes        String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("stock_count_item")
}

// ============================================================
// MÓDULO ALMACENCASITA — PRODUCTOS, CAJAS, MOVIMIENTOS Y SOLICITUDES
// ============================================================

model WarehouseProduct {
  id          String   @id @default(cuid())
  code        String   @unique @map("codigo")
  name        String   @map("nombre")
  brand       String?  @map("marca")
  color       String?  @map("color")
  capacity    String?  @map("capacidad")
  description String?  @map("descripcion") @db.Text
  boxes       Int      @default(0) @map("cajas")
  unitsPerBox Int      @default(1) @map("unidades_por_caja")
  looseUnits  Int      @default(0) @map("unidades_sueltas")
  totalUnits  Int      @default(0) @map("cantidad")
  status      String   @default("ACTIVE") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  movements    WarehouseMovement[]
  requestItems WarehouseRequestItem[]
  receiptImportLines WarehouseReceiptImportLine[]

  @@map("warehouse_product")
}

enum WarehouseReceiptImportStatus {
  ACTIVE
  CANCELLED

  @@map("warehouse_receipt_import_status")
}

model WarehouseReceiptImport {
  id           String                       @id @default(cuid())
  importNumber String                       @unique @map("import_number")
  receiptId    String                       @map("receipt_id")
  importedBy   String                       @map("imported_by")
  importedAt   DateTime                     @default(now()) @map("imported_at")
  status       WarehouseReceiptImportStatus @default(ACTIVE)
  cancelledAt  DateTime?                    @map("cancelled_at")
  cancelledBy  String?                      @map("cancelled_by")

  receipt GoodsReceipt              @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  lines   WarehouseReceiptImportLine[]

  @@index([receiptId, status])
  @@index([status, importedAt])
  @@map("warehouse_receipt_import")
}

model WarehouseReceiptImportLine {
  id          String   @id @default(cuid())
  importId    String   @map("import_id")
  productId   String   @map("product_id")
  itemId      String   @map("item_id")
  code        String
  name        String
  brand       String?
  capacity    String?
  color       String?
  unitsPerBox Int      @map("units_per_box")
  boxesCount  Int      @map("boxes_count")
  looseUnits  Int      @map("loose_units")
  totalUnits  Int      @map("total_units")

  import  WarehouseReceiptImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  product WarehouseProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([importId])
  @@index([productId])
  @@map("warehouse_receipt_import_line")
}

enum WarehouseMovementType {
  ENTRY
  EXIT

  @@map("warehouse_movement_type")
}

model WarehouseMovement {
  id         String                @id @default(cuid())
  productId  String                @map("product_id")
  product    WarehouseProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       WarehouseMovementType @map("tipo")
  boxesCount Int                   @default(1) @map("cantidad_cajas")
  totalUnits Int                   @default(0) @map("total_unidades")
  reason     String                @map("motivo")
  createdBy  String?               @map("created_by")
  createdAt  DateTime              @default(now()) @map("created_at")

  @@map("warehouse_movement")
}

enum WarehouseRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("warehouse_request_status")
}

enum WarehouseRequestType {
  ENTRY
  EXIT

  @@map("warehouse_request_type")
}

model WarehouseRequest {
  id          String                 @id @default(cuid())
  requestCode String                 @unique @map("request_code")
  title       String                 @map("titulo")
  branch      String                 @map("sucursal")
  requestedBy String                 @map("requested_by")
  type        WarehouseRequestType   @default(EXIT) @map("tipo")
  status      WarehouseRequestStatus @default(PENDING) @map("status")
  details     String?                @map("detalles") @db.Text
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  items WarehouseRequestItem[]

  @@index([status, createdAt])
  @@map("warehouse_request")
}

model WarehouseRequestItem {
  id         String           @id @default(cuid())
  requestId  String           @map("request_id")
  request    WarehouseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId  String           @map("product_id")
  product    WarehouseProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitsCount Int              @map("unidades")

  @@unique([requestId, productId])
  @@map("warehouse_request_item")
}

// ============================================================
// MÓDULO LISTA DE PRECIOS SDIGITAL
// ============================================================

model PriceListItem {
  id             String   @id @default(cuid())
  sku            String?  @unique @map("sku")
  model          String   @map("modelo")
  category       String   @default("Celulares") @map("categoria")
  brand          String?  @map("marca")
  capacity       String?  @map("capacidad")
  costPrice      Float    @default(0) @map("precio_costo")
  wholesalePrice Float    @default(0) @map("precio_mayorista")
  retailPrice    Float    @default(0) @map("precio_detallista")
  minPrice       Float?   @map("precio_minimo")
  notes          String?  @map("notas") @db.Text
  status         String   @default("ACTIVE") @map("status")
  isActive       Boolean  @default(false) @map("en_lista_activa")
  sortOrder      Int      @default(0) @map("orden_lista")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@index([status, isActive, sortOrder])
  @@map("price_list_item")
}

model PriceListBrand {
  id         String   @id @default(cuid())
  name       String   @unique @map("nombre")
  color      String   @default("#111827") @map("color")
  orderIndex Int      @default(0) @map("orden")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("price_list_brand")
}

model PriceListSetting {
  key       String   @id @map("clave")
  value     Json     @map("valor")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("price_list_setting")
}

// ============================================================
// MÓDULO FACTURA & CONDUCE PDF SDIGITAL
// ============================================================

enum InvoiceType {
  FACTURA
  CONDUCE

  @@map("invoice_type")
}

model Invoice {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique @map("numero_factura")
  ncf           String?     @map("ncf")
  type          InvoiceType @default(FACTURA) @map("tipo")
  clientName    String      @map("cliente_nombre")
  clientTaxId   String?     @map("cliente_rnc_cedula")
  clientPhone   String?     @map("cliente_telefono")
  clientAddress String?     @map("cliente_direccion")
  branch        String      @map("sucursal")
  paymentMethod String      @default("Efectivo") @map("metodo_pago")
  subtotal      Float       @default(0) @map("subtotal")
  tax           Float       @default(0) @map("itbis")
  discount      Float       @default(0) @map("descuento")
  total         Float       @default(0) @map("total")
  notes         String?     @map("notas") @db.Text
  status        String      @default("EMITIDA") @map("status")
  createdBy     String?     @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items InvoiceItem[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("invoice")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String  @map("descripcion")
  sku         String? @map("sku")
  imeis       String? @map("imeis") @db.Text
  quantity    Int     @default(1) @map("cantidad")
  unitPrice   Float   @default(0) @map("precio_unitario")
  tax         Float   @default(0) @map("itbis")
  totalPrice  Float   @default(0) @map("precio_total")

  @@map("invoice_item")
}
