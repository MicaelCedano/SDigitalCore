// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// TABLAS NEXTAUTH — Requeridas por Auth.js / NextAuth v5
// ============================================================

model User {
  id             String     @id @default(cuid())
  name           String?
  username       String?    @unique @map("username")
  email          String     @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?    @map("password_hash")
  phone          String?
  roleCode       String     @default("VENTAS") @map("role_code")
  allowedModules String[]   @default([]) @map("allowed_modules")
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  accounts               Account[]
  sessions               Session[]
  auditLogs              AuditLog[]
  wallet                 Wallet?
  legacyIdentities       LegacyUserIdentity[] @relation("LegacyIdentityCoreUser")
  legacyIdentitiesLinked LegacyUserIdentity[] @relation("LegacyIdentityLinkedBy")
  walletLedgerEntries    WalletLedgerEntry[]  @relation("WalletLedgerActor")
  redeemedWithdrawals    WalletLedgerEntry[]  @relation("WalletLedgerRedeemer")
  penaltiesReceived      Penalty[]            @relation("PenaltyTechnician")
  penaltiesApplied       Penalty[]            @relation("PenaltyAdmin")

  warrantiesCreated       WarrantyCase[]         @relation("WarrantyCreatedBy")
  warrantiesUpdated       WarrantyCase[]         @relation("WarrantyUpdatedBy")
  warrantiesAssigned      WarrantyCase[]         @relation("WarrantyAssignedTechnician")
  warrantiesArchived      WarrantyCase[]         @relation("WarrantyArchivedBy")
  businessPartnersCreated BusinessPartner[]      @relation("BusinessPartnerCreatedBy")
  warrantyEvents          WarrantyEvent[]
  warrantyDocuments       WarrantyDocument[]
  qcInspections           QcInspection[]         @relation("QcInspectionReviewer")
  assignedBatches         QcRevisionBatch[]      @relation("QcBatchAssignee")
  qcAssignedDevices       DeviceUnit[]           @relation("QcDeviceAssignee")
  qcImeiRequests          QcImeiRequest[]        @relation("QcImeiRequestRequester")
  qcImeiRequestsAccepted  QcImeiRequest[]        @relation("QcImeiRequestAcceptor")
  repairJobsCreated       RepairJob[]            @relation("RepairJobTechnician")
  repairJobsApproved      RepairJob[]            @relation("RepairJobApprovedBy")
  repairRates             TechnicianRepairRate[] @relation("TechnicianRepairRateTechnician")
  repairRatesManaged      TechnicianRepairRate[] @relation("TechnicianRepairRateAdmin")
  unlockRequestsCreated   UnlockRequest[]        @relation("UnlockRequestTechnician")
  unlockRequestsApproved  UnlockRequest[]        @relation("UnlockRequestAdmin")
  unlockRecordsCreated    UnlockRecord[]         @relation("UnlockRecordTechnician")
  unlockRecordsApproved   UnlockRecord[]         @relation("UnlockRecordAdmin")

  workTasksCreated           WorkTask[]         @relation("WorkTaskCreator")
  workTasksAssigned          WorkTask[]         @relation("WorkTaskAssignee")
  workTaskEvents             WorkTaskEvent[]
  workTaskAssignments        WorkTaskAssignee[] @relation("WorkTaskAssignmentUser")
  workTaskAssignmentsCreated WorkTaskAssignee[] @relation("WorkTaskAssignmentCreator")
  pushDevices                PushDevice[]
  shipmentsCreated           Shipment[]         @relation("ShipmentCreatedBy")
  shipmentsAssigned          Shipment[]         @relation("ShipmentDriver")

  @@map("user")
}

enum PushDevicePlatform {
  ANDROID

  @@map("push_device_platform")
}

model PushDevice {
  id         String             @id @default(cuid())
  userId     String             @map("user_id")
  token      String             @unique @db.Text
  platform   PushDevicePlatform
  appVersion String?            @map("app_version") @db.VarChar(32)
  lastSeenAt DateTime           @default(now()) @map("last_seen_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, lastSeenAt])
  @@map("push_device")
}

enum ShipmentStatus {
  DRAFT
  READY
  IN_TRANSIT
  PAUSED
  DELIVERED
  CANCELLED

  @@map("shipment_status")
}

enum ShipmentStopStatus {
  PENDING
  ARRIVED

  @@map("shipment_stop_status")
}

model Shipment {
  id                   String         @id @default(cuid())
  code                 String         @unique @db.VarChar(40)
  title                String         @db.VarChar(160)
  origin               String         @db.VarChar(300)
  destination          String         @db.VarChar(300)
  originAddressId      String?        @map("origin_address_id")
  destinationAddressId String?        @map("destination_address_id")
  vehicleLabel         String?        @map("vehicle_label") @db.VarChar(120)
  notes                String?        @db.Text
  status               ShipmentStatus @default(DRAFT)
  createdById          String         @map("created_by_id")
  driverId             String?        @map("driver_id")
  startedAt            DateTime?      @map("started_at")
  deliveredAt          DateTime?      @map("delivered_at")
  lastLatitude         Decimal?       @map("last_latitude") @db.Decimal(10, 7)
  lastLongitude        Decimal?       @map("last_longitude") @db.Decimal(10, 7)
  lastAccuracyMeters   Decimal?       @map("last_accuracy_meters") @db.Decimal(8, 2)
  lastSpeedMps         Decimal?       @map("last_speed_mps") @db.Decimal(8, 2)
  lastHeading          Decimal?       @map("last_heading") @db.Decimal(6, 2)
  lastLocationAt       DateTime?      @map("last_location_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  createdBy          User               @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  driver             User?              @relation("ShipmentDriver", fields: [driverId], references: [id], onDelete: SetNull)
  originAddress      ShipmentAddress?   @relation("ShipmentOriginAddress", fields: [originAddressId], references: [id], onDelete: SetNull)
  destinationAddress ShipmentAddress?   @relation("ShipmentDestinationAddress", fields: [destinationAddressId], references: [id], onDelete: SetNull)
  locations          ShipmentLocation[]
  stops              ShipmentStop[]

  @@index([status, lastLocationAt])
  @@index([driverId, status])
  @@map("shipment")
}

model ShipmentStop {
  id          String            @id @default(cuid())
  shipmentId  String            @map("shipment_id")
  name        String            @db.VarChar(160)
  address     String            @db.VarChar(400)
  mapsUrl     String?           @map("maps_url") @db.VarChar(1000)
  latitude    Decimal           @db.Decimal(10, 7)
  longitude   Decimal           @db.Decimal(10, 7)
  status      ShipmentStopStatus @default(PENDING)
  arrivedAt   DateTime?         @map("arrived_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, status])
  @@map("shipment_stop")
}

model ShipmentAddress {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(160)
  address         String   @db.VarChar(400)
  mapsUrl         String?  @map("maps_url") @db.VarChar(1000)
  isDefaultOrigin Boolean  @default(false) @map("is_default_origin")
  status          String   @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  originShipments      Shipment[] @relation("ShipmentOriginAddress")
  destinationShipments Shipment[] @relation("ShipmentDestinationAddress")

  @@index([status, name])
  @@map("shipment_address")
}

model ShipmentLocation {
  id             String   @id @default(cuid())
  shipmentId     String   @map("shipment_id")
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  accuracyMeters Decimal? @map("accuracy_meters") @db.Decimal(8, 2)
  speedMps       Decimal? @map("speed_mps") @db.Decimal(8, 2)
  heading        Decimal? @db.Decimal(6, 2)
  recordedAt     DateTime @map("recorded_at")
  receivedAt     DateTime @default(now()) @map("received_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, recordedAt])
  @@map("shipment_location")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  module     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

enum BusinessPartnerKind {
  CUSTOMER
  SUPPLIER
  BOTH

  @@map("business_partner_kind")
}

enum BusinessPartnerStatus {
  ACTIVE
  INACTIVE

  @@map("business_partner_status")
}

model BusinessPartner {
  id          String                @id @default(cuid())
  name        String                @db.VarChar(160)
  kind        BusinessPartnerKind
  taxId       String?               @map("tax_id") @db.VarChar(40)
  contactName String?               @map("contact_name") @db.VarChar(160)
  phone       String?               @db.VarChar(40)
  email       String?               @db.VarChar(200)
  address     String?               @db.VarChar(300)
  notes       String?               @db.Text
  status      BusinessPartnerStatus @default(ACTIVE)
  createdById String?               @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  createdBy     User?          @relation("BusinessPartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  warrantyCases WarrantyCase[]

  @@unique([name, kind])
  @@index([kind, status, name])
  @@index([phone])
  @@index([taxId])
  @@map("business_partner")
}

model AccessRequest {
  id            String              @id @default(cuid())
  name          String
  username      String              @unique
  email         String              @unique
  phone         String
  passwordHash  String              @map("password_hash")
  status        AccessRequestStatus @default(PENDING)
  assignedRole  String?             @map("assigned_role")
  customModules String[]            @default([]) @map("custom_modules")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("access_request")
}

enum WorkTaskKind {
  MANUAL
  AUTOMATIC
}

enum WorkTaskAssignmentMode {
  SINGLE
  MULTIPLE
}

enum WorkTaskStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum WorkTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkTaskEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  COMMENTED
  PROGRESS_UPDATED
  COMPLETED
}

model WorkTask {
  id             String                 @id @default(cuid())
  title          String
  description    String?                @db.Text
  kind           WorkTaskKind           @default(MANUAL)
  assignmentMode WorkTaskAssignmentMode @default(SINGLE) @map("assignment_mode")
  status         WorkTaskStatus         @default(PENDING)
  priority       WorkTaskPriority       @default(NORMAL)
  sourceModule   String                 @map("source_module")
  sourceType     String?                @map("source_type")
  sourceId       String?                @map("source_id")
  sourceCode     String?                @map("source_code")
  sourceUrl      String?                @map("source_url")
  creatorId      String                 @map("creator_id")
  assigneeId     String?                @map("assignee_id")
  dueAt          DateTime?              @map("due_at")
  startedAt      DateTime?              @map("started_at")
  completedAt    DateTime?              @map("completed_at")
  progressDone   Int                    @default(0) @map("progress_done")
  progressTotal  Int?                   @map("progress_total")
  recurrenceRule String?                @map("recurrence_rule")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  creator   User               @relation("WorkTaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee  User?              @relation("WorkTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events    WorkTaskEvent[]
  assignees WorkTaskAssignee[]

  @@index([assigneeId, status, dueAt])
  @@index([sourceModule, status, dueAt])
  @@index([creatorId, createdAt])
  @@map("work_task")
}

model WorkTaskAssignee {
  id           String   @id @default(cuid())
  taskId       String   @map("task_id")
  userId       String   @map("user_id")
  assignedById String?  @map("assigned_by_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  task       WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation("WorkTaskAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("WorkTaskAssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([taskId, userId])
  @@index([userId, assignedAt])
  @@map("work_task_assignee")
}

model WorkTaskEvent {
  id         String            @id @default(cuid())
  taskId     String            @map("task_id")
  actorId    String?           @map("actor_id")
  type       WorkTaskEventType
  note       String?           @db.Text
  beforeData Json?             @map("before_data")
  afterData  Json?             @map("after_data")
  createdAt  DateTime          @default(now()) @map("created_at")

  task  WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
  @@map("work_task_event")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("user_status")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("access_request_status")
}

enum LegacyIdentityMatchStatus {
  UNMATCHED
  SUGGESTED
  LINKED_PENDING_CUTOVER
  TRANSFERRED
  CONFLICT
  EXCLUDED

  @@map("legacy_identity_match_status")
}

enum LegacyMigrationMode {
  DRY_RUN
  APPLY
  CUTOVER

  @@map("legacy_migration_mode")
}

enum LegacyMigrationStatus {
  RUNNING
  COMPLETED
  FAILED
  REVERSED

  @@map("legacy_migration_status")
}

enum WalletStatus {
  ACTIVE
  FROZEN

  @@map("wallet_status")
}

enum WalletAccountKind {
  PRIMARY
  SAVINGS

  @@map("wallet_account_kind")
}

enum WalletLedgerEntryType {
  LEGACY_OPENING_BALANCE
  CREDIT
  DEBIT
  ADJUSTMENT
  REVERSAL

  @@map("wallet_ledger_entry_type")
}

enum WalletLedgerEntryStatus {
  POSTED
  VOID

  @@map("wallet_ledger_entry_status")
}

enum PenaltyType {
  INTERNAL
  EXTERNAL

  @@map("penalty_type")
}

enum PenaltyStatus {
  ACTIVE
  REVERSED

  @@map("penalty_status")
}

// ============================================================
// MIGRACION DE IDENTIDAD Y WALLET LEGACY
// ============================================================

model LegacyMigrationBatch {
  id                      String                @id @default(cuid())
  sourceSystem            String                @map("source_system") @db.VarChar(80)
  mode                    LegacyMigrationMode
  status                  LegacyMigrationStatus @default(RUNNING)
  cutoffAt                DateTime?             @map("cutoff_at")
  sourceUserCount         Int                   @default(0) @map("source_user_count")
  sourceWalletCount       Int                   @default(0) @map("source_wallet_count")
  sourceAccountCount      Int                   @default(0) @map("source_account_count")
  sourceTransactionCount  Int                   @default(0) @map("source_transaction_count")
  sourceBalanceTotal      Decimal               @default(0) @map("source_balance_total") @db.Decimal(14, 2)
  transferredUserCount    Int                   @default(0) @map("transferred_user_count")
  transferredBalanceTotal Decimal               @default(0) @map("transferred_balance_total") @db.Decimal(14, 2)
  checksum                String?               @db.VarChar(128)
  reconciliation          Json?
  errorMessage            String?               @map("error_message") @db.Text
  createdAt               DateTime              @default(now()) @map("created_at")
  completedAt             DateTime?             @map("completed_at")

  identities           LegacyUserIdentity[]
  archivedTransactions LegacyWalletTransaction[]
  archivedAccounts     LegacyWalletAccount[]
  ledgerEntries        WalletLedgerEntry[]

  @@index([sourceSystem, createdAt])
  @@index([status, createdAt])
  @@map("legacy_migration_batch")
}

model LegacyWalletAccount {
  id                  String    @id @default(cuid())
  sourceSystem        String    @map("source_system") @db.VarChar(80)
  sourceAccountId     String    @map("source_account_id") @db.VarChar(80)
  legacyIdentityId    String    @map("legacy_identity_id")
  nameSnapshot        String    @map("name_snapshot") @db.VarChar(160)
  typeSnapshot        String?   @map("type_snapshot") @db.VarChar(80)
  balanceSnapshot     Decimal   @default(0) @map("balance_snapshot") @db.Decimal(14, 2)
  savingsGoalSnapshot Decimal?  @map("savings_goal_snapshot") @db.Decimal(14, 2)
  colorSnapshot       String?   @map("color_snapshot") @db.VarChar(40)
  createdAtSnapshot   DateTime? @map("created_at_snapshot")
  batchId             String?   @map("batch_id")
  importedAt          DateTime  @default(now()) @map("imported_at")

  legacyIdentity LegacyUserIdentity    @relation(fields: [legacyIdentityId], references: [id], onDelete: Restrict)
  batch          LegacyMigrationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, sourceAccountId])
  @@index([legacyIdentityId])
  @@map("legacy_wallet_account")
}

model LegacyUserIdentity {
  id                     String                    @id @default(cuid())
  sourceSystem           String                    @map("source_system") @db.VarChar(80)
  sourceUserId           String                    @map("source_user_id") @db.VarChar(80)
  usernameSnapshot       String                    @map("username_snapshot") @db.VarChar(160)
  nameSnapshot           String?                   @map("name_snapshot") @db.VarChar(200)
  emailSnapshot          String?                   @map("email_snapshot") @db.VarChar(240)
  roleSnapshot           String?                   @map("role_snapshot") @db.VarChar(80)
  activeSnapshot         Boolean                   @default(true) @map("active_snapshot")
  sourceWalletBalance    Decimal                   @default(0) @map("source_wallet_balance") @db.Decimal(14, 2)
  sourceTransactionCount Int                       @default(0) @map("source_transaction_count")
  matchStatus            LegacyIdentityMatchStatus @default(UNMATCHED) @map("match_status")
  matchMethod            String?                   @map("match_method") @db.VarChar(80)
  coreUserId             String?                   @map("core_user_id")
  linkedById             String?                   @map("linked_by_id")
  linkedAt               DateTime?                 @map("linked_at")
  transferredAt          DateTime?                 @map("transferred_at")
  importedAt             DateTime                  @default(now()) @map("imported_at")
  lastSyncedAt           DateTime                  @default(now()) @map("last_synced_at")
  batchId                String?                   @map("batch_id")

  coreUser             User?                     @relation("LegacyIdentityCoreUser", fields: [coreUserId], references: [id], onDelete: Restrict)
  linkedBy             User?                     @relation("LegacyIdentityLinkedBy", fields: [linkedById], references: [id], onDelete: SetNull)
  batch                LegacyMigrationBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  archivedTransactions LegacyWalletTransaction[]
  archivedAccounts     LegacyWalletAccount[]

  @@unique([sourceSystem, sourceUserId])
  @@unique([sourceSystem, coreUserId])
  @@index([matchStatus, lastSyncedAt])
  @@index([usernameSnapshot])
  @@index([emailSnapshot])
  @@map("legacy_user_identity")
}

model LegacyWalletTransaction {
  id                  String    @id @default(cuid())
  sourceSystem        String    @map("source_system") @db.VarChar(80)
  sourceTransactionId String    @map("source_transaction_id") @db.VarChar(80)
  legacyIdentityId    String    @map("legacy_identity_id")
  amount              Decimal   @db.Decimal(14, 2)
  typeSnapshot        String    @map("type_snapshot") @db.VarChar(80)
  statusSnapshot      String?   @map("status_snapshot") @db.VarChar(80)
  descriptionSnapshot String?   @map("description_snapshot") @db.Text
  occurredAt          DateTime? @map("occurred_at")
  redeemedSnapshot    Boolean?  @map("redeemed_snapshot")
  batchId             String?   @map("batch_id")
  importedAt          DateTime  @default(now()) @map("imported_at")

  legacyIdentity LegacyUserIdentity    @relation(fields: [legacyIdentityId], references: [id], onDelete: Restrict)
  batch          LegacyMigrationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, sourceTransactionId])
  @@index([legacyIdentityId, occurredAt])
  @@map("legacy_wallet_transaction")
}

model Wallet {
  id        String       @id @default(cuid())
  userId    String       @unique @map("user_id")
  currency  String       @default("DOP") @db.Char(3)
  balance   Decimal      @default(0) @db.Decimal(14, 2)
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  accounts WalletAccount[]
  entries  WalletLedgerEntry[]

  @@index([status, updatedAt])
  @@map("wallet")
}

model WalletAccount {
  id              String            @id @default(cuid())
  walletId        String            @map("wallet_id")
  name            String            @db.VarChar(160)
  kind            WalletAccountKind
  balance         Decimal           @default(0) @db.Decimal(14, 2)
  savingsGoal     Decimal?          @map("savings_goal") @db.Decimal(14, 2)
  color           String?           @db.VarChar(40)
  sourceSystem    String?           @map("source_system") @db.VarChar(80)
  sourceAccountId String?           @map("source_account_id") @db.VarChar(80)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  wallet  Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries WalletLedgerEntry[]

  @@unique([sourceSystem, sourceAccountId])
  @@index([walletId, kind])
  @@map("wallet_account")
}

model WalletLedgerEntry {
  id           String                  @id @default(cuid())
  walletId     String                  @map("wallet_id")
  accountId    String                  @map("account_id")
  type         WalletLedgerEntryType
  status       WalletLedgerEntryStatus @default(POSTED)
  amount       Decimal                 @db.Decimal(14, 2)
  description  String?                 @db.Text
  externalKey  String                  @unique @map("external_key") @db.VarChar(255)
  secureToken  String?                 @unique @map("secure_token") @db.VarChar(64)
  actorId      String?                 @map("actor_id")
  batchId      String?                 @map("batch_id")
  reversalOfId String?                 @unique @map("reversal_of_id")
  redeemedAt   DateTime?               @map("redeemed_at")
  redeemedById String?                 @map("redeemed_by_id")
  occurredAt   DateTime                @default(now()) @map("occurred_at")
  createdAt    DateTime                @default(now()) @map("created_at")

  wallet     Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  account    WalletAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  actor      User?                 @relation("WalletLedgerActor", fields: [actorId], references: [id], onDelete: SetNull)
