// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// TABLAS NEXTAUTH — Requeridas por Auth.js / NextAuth v5
// ============================================================

model User {
  id             String     @id @default(cuid())
  name           String?
  username       String?    @unique @map("username")
  email          String     @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?    @map("password_hash")
  phone          String?
  roleCode       String     @default("VENTAS") @map("role_code")
  allowedModules String[]   @default([]) @map("allowed_modules")
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  auditLogs AuditLog[]
  wallet Wallet?
  legacyIdentities LegacyUserIdentity[] @relation("LegacyIdentityCoreUser")
  legacyIdentitiesLinked LegacyUserIdentity[] @relation("LegacyIdentityLinkedBy")
  walletLedgerEntries WalletLedgerEntry[] @relation("WalletLedgerActor")

  warrantiesCreated WarrantyCase[] @relation("WarrantyCreatedBy")
  warrantiesUpdated WarrantyCase[] @relation("WarrantyUpdatedBy")
  warrantiesAssigned WarrantyCase[]     @relation("WarrantyAssignedTechnician")
  warrantiesArchived WarrantyCase[]     @relation("WarrantyArchivedBy")
  warrantyEvents WarrantyEvent[]
  warrantyDocuments WarrantyDocument[]
  qcInspections QcInspection[] @relation("QcInspectionReviewer")
  assignedBatches QcRevisionBatch[] @relation("QcBatchAssignee")

  @@map("user")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  module     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model AccessRequest {
  id            String              @id @default(cuid())
  name          String
  username      String              @unique
  email         String              @unique
  phone         String
  passwordHash  String              @map("password_hash")
  status        AccessRequestStatus @default(PENDING)
  assignedRole  String?             @map("assigned_role")
  customModules String[]            @default([]) @map("custom_modules")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("access_request")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("user_status")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("access_request_status")
}

enum LegacyIdentityMatchStatus {
  UNMATCHED
  SUGGESTED
  LINKED_PENDING_CUTOVER
  TRANSFERRED
  CONFLICT
  EXCLUDED

  @@map("legacy_identity_match_status")
}

enum LegacyMigrationMode {
  DRY_RUN
  APPLY
  CUTOVER

  @@map("legacy_migration_mode")
}

enum LegacyMigrationStatus {
  RUNNING
  COMPLETED
  FAILED
  REVERSED

  @@map("legacy_migration_status")
}

enum WalletStatus {
  ACTIVE
  FROZEN

  @@map("wallet_status")
}

enum WalletAccountKind {
  PRIMARY
  SAVINGS

  @@map("wallet_account_kind")
}

enum WalletLedgerEntryType {
  LEGACY_OPENING_BALANCE
  CREDIT
  DEBIT
  ADJUSTMENT
  REVERSAL

  @@map("wallet_ledger_entry_type")
}

enum WalletLedgerEntryStatus {
  POSTED
  VOID

  @@map("wallet_ledger_entry_status")
}

// ============================================================
// MIGRACION DE IDENTIDAD Y WALLET LEGACY
// ============================================================

model LegacyMigrationBatch {
  id                    String                @id @default(cuid())
  sourceSystem          String                @map("source_system") @db.VarChar(80)
  mode                  LegacyMigrationMode
  status                LegacyMigrationStatus @default(RUNNING)
  cutoffAt              DateTime?             @map("cutoff_at")
  sourceUserCount       Int                   @default(0) @map("source_user_count")
  sourceWalletCount     Int                   @default(0) @map("source_wallet_count")
  sourceAccountCount    Int                   @default(0) @map("source_account_count")
  sourceTransactionCount Int                  @default(0) @map("source_transaction_count")
  sourceBalanceTotal    Decimal               @default(0) @map("source_balance_total") @db.Decimal(14, 2)
  transferredUserCount  Int                   @default(0) @map("transferred_user_count")
  transferredBalanceTotal Decimal             @default(0) @map("transferred_balance_total") @db.Decimal(14, 2)
  checksum              String?               @db.VarChar(128)
  reconciliation        Json?
  errorMessage          String?               @map("error_message") @db.Text
  createdAt             DateTime              @default(now()) @map("created_at")
  completedAt           DateTime?             @map("completed_at")

  identities LegacyUserIdentity[]
  archivedTransactions LegacyWalletTransaction[]
  archivedAccounts LegacyWalletAccount[]
  ledgerEntries WalletLedgerEntry[]

  @@index([sourceSystem, createdAt])
  @@index([status, createdAt])
  @@map("legacy_migration_batch")
}

model LegacyWalletAccount {
  id                String   @id @default(cuid())
  sourceSystem      String   @map("source_system") @db.VarChar(80)
  sourceAccountId   String   @map("source_account_id") @db.VarChar(80)
  legacyIdentityId  String   @map("legacy_identity_id")
  nameSnapshot      String   @map("name_snapshot") @db.VarChar(160)
  typeSnapshot      String?  @map("type_snapshot") @db.VarChar(80)
  balanceSnapshot   Decimal  @default(0) @map("balance_snapshot") @db.Decimal(14, 2)
  savingsGoalSnapshot Decimal? @map("savings_goal_snapshot") @db.Decimal(14, 2)
  colorSnapshot     String?  @map("color_snapshot") @db.VarChar(40)
  createdAtSnapshot DateTime? @map("created_at_snapshot")
  batchId           String?  @map("batch_id")
  importedAt        DateTime @default(now()) @map("imported_at")

  legacyIdentity LegacyUserIdentity @relation(fields: [legacyIdentityId], references: [id], onDelete: Restrict)
  batch LegacyMigrationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, sourceAccountId])
  @@index([legacyIdentityId])
  @@map("legacy_wallet_account")
}

model LegacyUserIdentity {
  id                     String                    @id @default(cuid())
  sourceSystem           String                    @map("source_system") @db.VarChar(80)
  sourceUserId           String                    @map("source_user_id") @db.VarChar(80)
  usernameSnapshot       String                    @map("username_snapshot") @db.VarChar(160)
  nameSnapshot           String?                   @map("name_snapshot") @db.VarChar(200)
  emailSnapshot          String?                   @map("email_snapshot") @db.VarChar(240)
  roleSnapshot           String?                   @map("role_snapshot") @db.VarChar(80)
  activeSnapshot         Boolean                   @default(true) @map("active_snapshot")
  sourceWalletBalance    Decimal                   @default(0) @map("source_wallet_balance") @db.Decimal(14, 2)
  sourceTransactionCount Int                       @default(0) @map("source_transaction_count")
  matchStatus            LegacyIdentityMatchStatus @default(UNMATCHED) @map("match_status")
  matchMethod            String?                   @map("match_method") @db.VarChar(80)
  coreUserId             String?                   @map("core_user_id")
  linkedById             String?                   @map("linked_by_id")
  linkedAt               DateTime?                 @map("linked_at")
  transferredAt          DateTime?                 @map("transferred_at")
  importedAt             DateTime                  @default(now()) @map("imported_at")
  lastSyncedAt           DateTime                  @default(now()) @map("last_synced_at")
  batchId                String?                   @map("batch_id")

  coreUser User? @relation("LegacyIdentityCoreUser", fields: [coreUserId], references: [id], onDelete: Restrict)
  linkedBy User? @relation("LegacyIdentityLinkedBy", fields: [linkedById], references: [id], onDelete: SetNull)
  batch LegacyMigrationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  archivedTransactions LegacyWalletTransaction[]
  archivedAccounts LegacyWalletAccount[]

  @@unique([sourceSystem, sourceUserId])
  @@unique([sourceSystem, coreUserId])
  @@index([matchStatus, lastSyncedAt])
  @@index([usernameSnapshot])
  @@index([emailSnapshot])
  @@map("legacy_user_identity")
}

model LegacyWalletTransaction {
  id                  String   @id @default(cuid())
  sourceSystem        String   @map("source_system") @db.VarChar(80)
  sourceTransactionId String   @map("source_transaction_id") @db.VarChar(80)
  legacyIdentityId    String   @map("legacy_identity_id")
  amount              Decimal  @db.Decimal(14, 2)
  typeSnapshot        String   @map("type_snapshot") @db.VarChar(80)
  statusSnapshot      String?  @map("status_snapshot") @db.VarChar(80)
  descriptionSnapshot String?  @map("description_snapshot") @db.Text
  occurredAt          DateTime? @map("occurred_at")
  redeemedSnapshot    Boolean? @map("redeemed_snapshot")
  batchId             String?  @map("batch_id")
  importedAt          DateTime @default(now()) @map("imported_at")

  legacyIdentity LegacyUserIdentity @relation(fields: [legacyIdentityId], references: [id], onDelete: Restrict)
  batch LegacyMigrationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, sourceTransactionId])
  @@index([legacyIdentityId, occurredAt])
  @@map("legacy_wallet_transaction")
}

model Wallet {
  id        String       @id @default(cuid())
  userId    String       @unique @map("user_id")
  currency  String       @default("DOP") @db.Char(3)
  balance   Decimal      @default(0) @db.Decimal(14, 2)
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  accounts WalletAccount[]
  entries WalletLedgerEntry[]

  @@index([status, updatedAt])
  @@map("wallet")
}

model WalletAccount {
  id              String            @id @default(cuid())
  walletId        String            @map("wallet_id")
  name            String            @db.VarChar(160)
  kind            WalletAccountKind
  balance         Decimal           @default(0) @db.Decimal(14, 2)
  savingsGoal     Decimal?          @map("savings_goal") @db.Decimal(14, 2)
  color           String?           @db.VarChar(40)
  sourceSystem    String?           @map("source_system") @db.VarChar(80)
  sourceAccountId String?           @map("source_account_id") @db.VarChar(80)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries WalletLedgerEntry[]

  @@unique([sourceSystem, sourceAccountId])
  @@index([walletId, kind])
  @@map("wallet_account")
}

model WalletLedgerEntry {
  id          String                  @id @default(cuid())
  walletId    String                  @map("wallet_id")
  accountId   String                  @map("account_id")
  type        WalletLedgerEntryType
  status      WalletLedgerEntryStatus @default(POSTED)
  amount      Decimal                 @db.Decimal(14, 2)
  description String?                 @db.Text
  externalKey String                  @unique @map("external_key") @db.VarChar(255)
  actorId     String?                 @map("actor_id")
  batchId     String?                 @map("batch_id")
  reversalOfId String?                @unique @map("reversal_of_id")
  occurredAt  DateTime                @default(now()) @map("occurred_at")
  createdAt   DateTime                @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  account WalletAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  actor User? @relation("WalletLedgerActor", fields: [actorId], references: [id], onDelete: SetNull)
  batch LegacyMigrationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  reversalOf WalletLedgerEntry? @relation("WalletLedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy WalletLedgerEntry? @relation("WalletLedgerReversal")

  @@index([walletId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([batchId])
  @@map("wallet_ledger_entry")
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
  CANCELLED

  @@map("goods_receipt_status")
}

enum DeviceOperationalStatus {
  PENDING_QC
  IN_QC
  AVAILABLE
  QUARANTINED
  ARCHIVED
}

enum QcInspectionStatus {
  DRAFT
  COMPLETED
  SUPERSEDED
}

enum QcInspectionResult {
  FUNCTIONAL
  NON_FUNCTIONAL
  UNSPECIFIED
}

enum QcBatchStatus {
  DRAFT
  PENDING_REVIEW
  IN_REVIEW
  COMPLETED
  CANCELLED

  @@map("qc_batch_status")
}

// ============================================================
// CONTROL DE CALIDAD — Equipos individualizados e inspecciones
// ============================================================

model QcRevisionBatch {
  id                 String        @id @default(cuid())
  batchNumber        String        @unique @map("batch_number") @db.VarChar(60)
  supplierId         String?       @map("supplier_id")
  supplierName       String        @map("supplier_name") @db.VarChar(160)
  branch             String        @db.VarChar(100)
  receivedBy         String        @map("received_by") @db.VarChar(160)
  assignedToId       String?       @map("assigned_to_id")
  status             QcBatchStatus @default(PENDING_REVIEW)
  totalDevices       Int           @default(0) @map("total_devices")
  reviewedDevices    Int           @default(0) @map("reviewed_devices")
  functionalCount    Int           @default(0) @map("functional_count")
  nonFunctionalCount Int           @default(0) @map("non_functional_count")
  notes              String?       @db.Text
  receivedAt         DateTime      @default(now()) @map("received_at")
  completedAt        DateTime?     @map("completed_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  assignedTo User? @relation("QcBatchAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  devices DeviceUnit[]

  @@index([status, receivedAt])
  @@index([assignedToId])
  @@index([supplierName, receivedAt])
  @@map("qc_revision_batch")
}

model DeviceUnit {
  id             String                  @id @default(cuid())
  imei           String?                 @unique @db.VarChar(20)
  serialNumber   String?                 @unique @map("serial_number") @db.VarChar(120)
  brand          String?                 @db.VarChar(100)
  model          String                  @db.VarChar(150)
  storageGb      Int?                    @map("storage_gb")
  color          String?                 @db.VarChar(80)
  status         DeviceOperationalStatus @default(PENDING_QC)
  batchId        String?                 @map("batch_id")
  sourceSystem   String?                 @map("source_system") @db.VarChar(50)
  sourceRecordId String?                 @map("source_record_id") @db.VarChar(80)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  batch       QcRevisionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  inspections QcInspection[]

  @@index([status, updatedAt])
  @@index([brand, model])
  @@index([batchId])
  @@unique([sourceSystem, sourceRecordId])
  @@map("device_unit")
}

model QcInspection {
  id                   String              @id @default(cuid())
  deviceId             String              @map("device_id")
  reviewerId           String?             @map("reviewer_id")
  reviewerNameSnapshot String              @map("reviewer_name_snapshot") @db.VarChar(160)
  status               QcInspectionStatus  @default(DRAFT)
  result               QcInspectionResult?
  grade                String?             @db.VarChar(16)
  batteryHealth        Int?                @map("battery_health")
  functionalityNotes   String?             @map("functionality_notes") @db.Text
  physicalNotes        String?             @map("physical_notes") @db.Text
  reviewedAt           DateTime?           @map("reviewed_at")
  supersedesId         String?             @unique @map("supersedes_id")
  sourceSystem         String?             @map("source_system") @db.VarChar(50)
  sourceRecordId       String?             @map("source_record_id") @db.VarChar(80)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  device      DeviceUnit     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  reviewer    User?          @relation("QcInspectionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  supersedes  QcInspection?  @relation("QcInspectionCorrections", fields: [supersedesId], references: [id], onDelete: Restrict)
  corrections QcInspection[] @relation("QcInspectionCorrections")

  @@index([deviceId, reviewedAt])
  @@index([reviewerId, reviewedAt])
  @@index([status, reviewedAt])
  @@index([result, reviewedAt])
  @@unique([sourceSystem, sourceRecordId])
  @@map("qc_inspection")
}

enum WarrantyStatus {
  RECEIVED
  IN_REPAIR
  RECEIVED_FROM_TECHNICIAN
  SENT_TO_SUPPLIER
  RECEIVED_FROM_SUPPLIER
  DELIVERED
  CREDIT_NOTE

  @@map("warranty_status")
}

enum WarrantyEventType {
  CREATED
  DETAILS_UPDATED
  STATUS_CHANGED
  ASSIGNED_TO_TECHNICIAN
  RECEIVED_REPAIRED
  RECEIVED_UNREPAIRED
  SENT_TO_SUPPLIER
  RECEIVED_FROM_SUPPLIER
  DELIVERED_TO_CUSTOMER
  CREDIT_NOTE_MARKED
  ARCHIVED
  RESTORED

  @@map("warranty_event_type")
}

enum WarrantyDocumentType {
  INTAKE_RECEIPT
  TECHNICIAN_ASSIGNMENT
  TECHNICIAN_RECEIPT_REPAIRED
  TECHNICIAN_RECEIPT_UNREPAIRED
  SUPPLIER_SHIPMENT
  SUPPLIER_RECEIPT
  CUSTOMER_DELIVERY
  CREDIT_NOTE

  @@map("warranty_document_type")
}

model WarrantyCase {
  id                    String   @id @default(cuid())
  caseCode              String   @unique @map("case_code")
  imei                  String
  model                 String
  color                 String?
  clientName            String   @map("client_name")
  problem               String   @db.Text
  status                WarrantyStatus @default(RECEIVED)
  entryDate             DateTime @db.Date @map("entry_date")
  createdById           String?  @map("created_by_id")
  updatedById           String?  @map("updated_by_id")
  assignedTechnicianId  String?  @map("assigned_technician_id")
  assignedTechnicianName String?        @map("assigned_technician_name")
  currentSupplierName   String?  @map("current_supplier_name")
  archivedAt            DateTime? @map("archived_at")
  archivedById          String?  @map("archived_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("WarrantyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("WarrantyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  assignedTechnician User? @relation("WarrantyAssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  archivedBy User? @relation("WarrantyArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  events WarrantyEvent[]
  documentItems WarrantyDocumentItem[]

  @@index([imei, createdAt])
  @@index([status, entryDate])
  @@index([clientName])
  @@index([archivedAt])
  @@map("warranty_case")
}

model WarrantyEvent {
  id String @id @default(cuid())
  caseId String @map("case_id")
  type WarrantyEventType
  fromStatus WarrantyStatus? @map("from_status")
  toStatus WarrantyStatus? @map("to_status")
  actorId String? @map("actor_id")
  actorNameSnapshot String? @map("actor_name_snapshot")
  counterpartyName String? @map("counterparty_name")
  reason String? @db.Text
  beforeData Json? @map("before_data")
  afterData Json? @map("after_data")
  createdAt DateTime @default(now()) @map("created_at")

  case WarrantyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("warranty_event")
}

model WarrantyDocument {
  id String @id @default(cuid())
  documentCode String @unique @map("document_code")
  type WarrantyDocumentType
  counterpartyName String @map("counterparty_name")
  documentDate DateTime @db.Date @map("document_date")
  createdById String? @map("created_by_id")
  notes String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items WarrantyDocumentItem[]

  @@index([type, documentDate])
  @@map("warranty_document")
}

model WarrantyDocumentItem {
  id String @id @default(cuid())
  documentId String @map("document_id")
  caseId String @map("case_id")
  sortOrder Int @default(0) @map("sort_order")

  document WarrantyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  case WarrantyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([documentId, caseId])
  @@index([caseId])
  @@map("warranty_document_item")
}

model WarrantyDailySequence {
  id String @id @default(cuid())
  sequenceDate DateTime @db.Date @map("sequence_date")
  sequenceType String @map("sequence_type")
  lastValue Int @default(0) @map("last_value")

  @@unique([sequenceDate, sequenceType])
  @@map("warranty_daily_sequence")
}

model OperationalDailySequence {
  id           String   @id @default(cuid())
  sequenceDate DateTime @db.Date @map("sequence_date")
  sequenceType String   @map("sequence_type")
  lastValue    Int      @default(0) @map("last_value")

  @@unique([sequenceDate, sequenceType])
  @@map("operational_daily_sequence")
}

// ============================================================
// MÓDULO ALMACÉN — Recibos de Mercancía
// ============================================================

model GoodsReceipt {
  id            String             @id @default(cuid())
  receiptNumber String             @unique @map("receipt_number")
  supplierName  String             @map("supplier_name")
  branch        String
  receivedBy    String             @map("received_by")
  status        GoodsReceiptStatus @default(COMPLETED)
  notes         String?            @db.Text
  receivedAt    DateTime           @default(now()) @map("received_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  items GoodsReceiptItem[]

  @@map("goods_receipt")
}

model GoodsReceiptItem {
  id            String       @id @default(cuid())
  receiptId     String       @map("receipt_id")
  receipt       GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  code          String?
  description   String
  quantity      Int          @default(1)
  unitPrice     Float?       @map("unit_price")
  condition     String?      @default("Nuevo")
  imeiOrSerial  String?      @map("imei_or_serial") @db.Text
  colorVariants Json?        @map("color_variants")
  notes         String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("goods_receipt_item")
}

model CatalogModel {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?  @default("Celulares")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("catalog_model")
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  address   String?
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branch")
}

enum QcSupplierStatus {
  ACTIVE
  INACTIVE

  @@map("qc_supplier_status")
}

model QcSupplier {
  id             String           @id @default(cuid())
  name           String           @unique @db.VarChar(160)
  contactName    String?          @map("contact_name") @db.VarChar(160)
  phone          String?          @db.VarChar(40)
  email          String?          @db.VarChar(200)
  notes          String?          @db.Text
  status         QcSupplierStatus @default(ACTIVE)
  sourceSystem   String?          @map("source_system") @db.VarChar(50)
  sourceRecordId String?          @map("source_record_id") @db.VarChar(80)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([status, name])
  @@unique([sourceSystem, sourceRecordId])
  @@map("qc_supplier")
}

enum StockCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("stock_count_status")
}

// ============================================================
// CONTEO DE STOCK & AUDITORÍA DE INVENTARIO
// ============================================================

model StockCount {
  id          String           @id @default(cuid())
  countNumber String           @unique @map("count_number")
  title       String           @default("Conteo Físico de Stock")
  branch      String
  performedBy String           @map("performed_by")
  status      StockCountStatus @default(IN_PROGRESS)
  notes       String?          @db.Text
  startedAt   DateTime         @default(now()) @map("started_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  items StockCountItem[]

  @@map("stock_count")
}

model StockCountItem {
  id           String     @id @default(cuid())
  countId      String     @map("count_id")
  count        StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  code         String?
  description  String
  expectedQty  Int        @default(0) @map("expected_qty")
  countedQty   Int        @default(0) @map("counted_qty")
  difference   Int        @default(0)
  scannedImeis String?    @map("scanned_imeis") @db.Text
  notes        String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("stock_count_item")
}

// ============================================================
// MÓDULO ALMACENCASITA — PRODUCTOS, CAJAS, MOVIMIENTOS Y SOLICITUDES
// ============================================================

model WarehouseProduct {
  id          String   @id @default(cuid())
  code        String   @unique @map("codigo")
  name        String   @map("nombre")
  brand       String?  @map("marca")
  color       String?  @map("color")
  capacity    String?  @map("capacidad")
  description String?  @map("descripcion") @db.Text
  boxes       Int      @default(0) @map("cajas")
  unitsPerBox Int      @default(1) @map("unidades_por_caja")
  looseUnits  Int      @default(0) @map("unidades_sueltas")
  totalUnits  Int      @default(0) @map("cantidad")
  status      String   @default("ACTIVE") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  movements WarehouseMovement[]
  requestItems WarehouseRequestItem[]

  @@map("warehouse_product")
}

enum WarehouseMovementType {
  ENTRY
  EXIT

  @@map("warehouse_movement_type")
}

model WarehouseMovement {
  id         String                @id @default(cuid())
  productId  String                @map("product_id")
  product    WarehouseProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       WarehouseMovementType @map("tipo")
  boxesCount Int                   @default(1) @map("cantidad_cajas")
  totalUnits Int                   @default(0) @map("total_unidades")
  reason     String                @map("motivo")
  createdBy  String?               @map("created_by")
  createdAt  DateTime              @default(now()) @map("created_at")

  @@map("warehouse_movement")
}

enum WarehouseRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("warehouse_request_status")
}

enum WarehouseRequestType {
  ENTRY
  EXIT

  @@map("warehouse_request_type")
}

model WarehouseRequest {
  id          String                 @id @default(cuid())
  requestCode String                 @unique @map("request_code")
  title       String                 @map("titulo")
  branch      String                 @map("sucursal")
  requestedBy String                 @map("requested_by")
  type        WarehouseRequestType    @default(EXIT) @map("tipo")
  status      WarehouseRequestStatus @default(PENDING) @map("status")
  details     String?                @map("detalles") @db.Text
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  items       WarehouseRequestItem[]

  @@map("warehouse_request")
}

model WarehouseRequestItem {
  id        String          @id @default(cuid())
  requestId String          @map("request_id")
  request   WarehouseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId String          @map("product_id")
  product   WarehouseProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitsCount Int            @map("unidades")

  @@unique([requestId, productId])
  @@map("warehouse_request_item")
}

// ============================================================
// MÓDULO LISTA DE PRECIOS SDIGITAL
// ============================================================

model PriceListItem {
  id             String   @id @default(cuid())
  sku            String?  @unique @map("sku")
  model          String   @map("modelo")
  category       String   @default("Celulares") @map("categoria")
  brand          String?  @map("marca")
  capacity       String?  @map("capacidad")
  costPrice      Float    @default(0) @map("precio_costo")
  wholesalePrice Float    @default(0) @map("precio_mayorista")
  retailPrice    Float    @default(0) @map("precio_detallista")
  minPrice       Float?   @map("precio_minimo")
  notes          String?  @map("notas") @db.Text
  status         String   @default("ACTIVE") @map("status")
  isActive       Boolean  @default(false) @map("en_lista_activa")
  sortOrder      Int      @default(0) @map("orden_lista")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("price_list_item")
}

model PriceListBrand {
  id         String   @id @default(cuid())
  name       String   @unique @map("nombre")
  color      String   @default("#111827") @map("color")
  orderIndex Int      @default(0) @map("orden")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("price_list_brand")
}

model PriceListSetting {
  key       String   @id @map("clave")
  value     Json     @map("valor")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("price_list_setting")
}

// ============================================================
// MÓDULO FACTURA & CONDUCE PDF SDIGITAL
// ============================================================

enum InvoiceType {
  FACTURA
  CONDUCE

  @@map("invoice_type")
}

model Invoice {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique @map("numero_factura")
  ncf           String?     @map("ncf")
  type          InvoiceType @default(FACTURA) @map("tipo")
  clientName    String      @map("cliente_nombre")
  clientTaxId   String?     @map("cliente_rnc_cedula")
  clientPhone   String?     @map("cliente_telefono")
  clientAddress String?     @map("cliente_direccion")
  branch        String      @map("sucursal")
  paymentMethod String      @default("Efectivo") @map("metodo_pago")
  subtotal      Float       @default(0) @map("subtotal")
  tax           Float       @default(0) @map("itbis")
  discount      Float       @default(0) @map("descuento")
  total         Float       @default(0) @map("total")
  notes         String?     @map("notas") @db.Text
  status        String      @default("EMITIDA") @map("status")
  createdBy     String?     @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items InvoiceItem[]

  @@map("invoice")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String  @map("descripcion")
  sku         String? @map("sku")
  imeis       String? @map("imeis") @db.Text
  quantity    Int     @default(1) @map("cantidad")
  unitPrice   Float   @default(0) @map("precio_unitario")
  tax         Float   @default(0) @map("itbis")
  totalPrice  Float   @default(0) @map("precio_total")

  @@map("invoice_item")
}
